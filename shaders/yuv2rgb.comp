#version 450

// Planar JPEG YCbCr (JFIF: full range, BT.601) -> RGBA8, one invocation per
// output pixel. The chroma planes may be subsampled (4:2:2, 4:2:0, ...): they
// are sampled with a linear filter at the pixel centre, which reproduces the
// "centred" chroma siting JPEG uses (the same triangle filter libjpeg's fancy
// upsampling applies for 2:1).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uY;  // luma, same size as the output
layout(set = 0, binding = 1) uniform sampler2D uCb;
layout(set = 0, binding = 2) uniform sampler2D uCr;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D uOut;

void main()
{
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(uOut);
    if (p.x >= size.x || p.y >= size.y)
        return;

    // Chroma is subsampled by a whole factor per axis (1 or 2). Derive it from
    // the plane sizes and scale by it exactly: dividing by the luma size instead
    // would drift by up to half a chroma texel on odd widths/heights, where the
    // chroma plane is ceil(size / factor) wide.
    const ivec2 cSize = textureSize(uCb, 0);
    const ivec2 factor = max((size + cSize / 2) / cSize, ivec2(1));
    const vec2 uvC = (vec2(p) + 0.5) / vec2(factor * cSize);

    const float y = texelFetch(uY, p, 0).r;
    const float cb = texture(uCb, uvC).r - 128.0 / 255.0;
    const float cr = texture(uCr, uvC).r - 128.0 / 255.0;

    const vec3 rgb = vec3(y + 1.402 * cr,
                          y - 0.344136 * cb - 0.714136 * cr,
                          y + 1.772 * cb);
    imageStore(uOut, p, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
