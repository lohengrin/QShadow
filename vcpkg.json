{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "qshadow",
  "version": "1.0.0",
  "description": "Low-latency viewer for the GENKI ShadowCast capture dongle",
  "builtin-baseline": "6ade29bbd5a4c7e99439ec52adbc63c073953a57",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "concurrent", "doubleconversion", "freetype", "gui", "harfbuzz",
        "network", "pcre2", "png", "testlib", "thread", "vulkan",
        "widgets", "windeployqt"
      ]
    },
    {
      "name": "qtmultimedia",
      "default-features": false
    },
    "libjpeg-turbo",
    "vulkan-headers",
    "vulkan-loader",
    {
      "name": "glslang",
      "features": ["tools"]
    }
  ]
}
